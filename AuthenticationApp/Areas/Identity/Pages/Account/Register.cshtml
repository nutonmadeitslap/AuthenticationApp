@page
@model RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-lg">
                <div class="card-body">

                    <h2 class="fw-bold text-center mb-4">Регистрация</h2>

                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" placeholder="email" />
                            <label asp-for="Input.Email">Электронная почта</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" placeholder="пароль" />
                            <label asp-for="Input.Password">Пароль</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.ConfirmPassword" class="form-control" placeholder="подтвердите пароль" />
                            <label asp-for="Input.ConfirmPassword">Подтверждение пароля</label>
                        </div>

                        <button class="btn btn-primary w-100">Создать аккаунт</button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}