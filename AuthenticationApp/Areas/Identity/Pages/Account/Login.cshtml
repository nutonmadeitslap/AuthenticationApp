@page
@model LoginModel

@{
    ViewData["Title"] = "Войти";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow-lg">
                <div class="card-body">

                    <h2 class="fw-bold text-center mb-4">Вход</h2>

                    <form method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" placeholder="email" />
                            <label asp-for="Input.Email">E-mail</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" placeholder="password" />
                            <label asp-for="Input.Password">Пароль</label>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe">Запомнить меня</label>
                        </div>

                        <button class="btn btn-primary w-100 mb-3">Войти</button>

                        <div class="text-center">
                            <a asp-page="./ForgotPassword">Забыли пароль?</a><br />
                            <a asp-page="./Register">Регистрация</a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}