<!DOCTYPE html>
<html lang="en">
<style>
    body {
        background: linear-gradient(135deg, #4e73df, #1cc88a);
        min-height: 100vh;
        background-attachment: fixed;
        color: #fff;
    }

    .card {
        border-radius: 18px;
        border: none;
        backdrop-filter: blur(8px);
        background: rgba(255, 255, 255, 0.13);
        color: #fff;
    }

    .card-body {
        padding: 2rem 2.2rem;
    }

    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
    }

    .form-control:focus, .form-select:focus {
        background: rgba(255, 255, 255, 0.25);
        box-shadow: 0 0 0 .25rem rgba(255,255,255,.25);
        color: #fff;
    }

    label {
        color: #e4e4e4 !important;
    }

    .btn-primary {
        background: #1a237e;
        border: none;
        transition: 0.25s;
    }

    .btn-primary:hover {
        background: #283593;
        transform: translateY(-2px);
        box-shadow: 0 8px 14px rgba(0,0,0,0.25);
    }

    .btn-outline-secondary {
        border-color: #fff;
        color: #fff;
    }

    .btn-outline-secondary:hover {
        background: #fff;
        color: #000;
    }

    table {
        color: #fff !important;
    }

    thead {
        background: rgba(255,255,255,0.2) !important;
    }

    .table-hover tbody tr:hover {
        background: rgba(255,255,255,0.1) !important;
    }

    a {
        color: #fff !important;
        transition: .2s;
        text-decoration: underline;
    }

    a:hover {
        text-shadow: 0 0 6px #fff;
    }
</style>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AuthenticationApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AuthenticationApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">AuthenticationApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Домой</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AuthenticationApp - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>